# International Solar Technology Partner Matching Agent - Environment Configuration
# Copy this file to .env and insert your real credentials.
# DO NOT commit .env to any version control repository.

# Application Environment (development, testing, production)
APP_ENV=development
LOG_LEVEL=INFO

# Provider LLM Gateway Keys
# Configure one or more provider keys; system gracefully degrades to deterministic matching if omitted.
OPENROUTER_API_KEY=your_openrouter_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Default Model Selection per Adapter
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
GEMINI_MODEL=gemini-1.5-flash

# Model Gateway Execution Settings
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_SECONDS=1.0

# Local Storage
DATABASE_PATH=database/solar_agent.db
VERIFIED_DATA_PATH=data/verified_providers.json
SAMPLE_FIXTURES_PATH=data/sample_fixtures.json
